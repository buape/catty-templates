#!/bin/sh
# buapedb — fetch short-lived DB credentials from OpenBao (buape).
#
# Usage:
#   buapedb <name>               # read-only, e.g. buapedb orbit, buapedb orbit-ro
#   buapedb <name> --write       # read-write access
#   buapedb --renew <id>         # extend one of your credentials (+1h)
#   buapedb --end                # revoke all credentials minted from this machine
#   buapedb list                 # show available database mounts and roles
#
# Behavior: logs in via Buape Auth SSO in the browser if needed, mints a
# short-lived Postgres user for the requested role, prints the username and
# puts the password in the clipboard (pbcopy) for pasting into TablePlus.
# The credential is unique per request and dies with its lease.
#
# Nothing is hardcoded: mounts and roles are read from OpenBao directly, so
# new databases/roles appear automatically.
#
# Requires: bao (or vault), jq. macOS: pbcopy.

set -eu

BAO_ADDR="${BAO_ADDR:-https://bao.b1.buape.com}"
export BAO_ADDR
LEDGER="${HOME}/.buapedb/leases"   # lease ids minted by this machine, one JSON line per request

# find the CLI
if command -v bao >/dev/null 2>&1; then CLI=bao
elif command -v vault >/dev/null 2>&1; then CLI=vault
else echo "need the openbao/vault CLI: brew install openbao" >&2; exit 1; fi

# login only when we don't hold a token yet; browser handles Buape Auth SSO
_login_once() {
    if ! "$CLI" token lookup >/dev/null 2>&1; then
        echo "logging in via Buape Auth…"
        "$CLI" login -method=oidc >/dev/null
    fi
}

if [ "${1:-}" = "--renew" ] || [ "${2:-}" = "--renew" ]; then
    if [ "${1:-}" = "--renew" ]; then target_id="${2:-}"; else target_id="${3:-}"; fi
    [ -n "${target_id:-}" ] || { echo "usage: buapedb [name] --renew <id>" >&2; exit 1; }
    # accept the short id printed by buapedb or the full lease path
    case "$target_id" in *"/creds/"*) lease="$target_id" ;; *) echo "lease id must be a full path like orbit-db/creds/orbit-ro/<id>" >&2; exit 1 ;; esac
    _login_once
    out=$("$CLI" lease renew -format=json "$lease" 2>&1) || { echo "failed to renew $lease — expired or not renewable" >&2; exit 1; }
    dur=$(printf '%s' "$out" | jq -r '.lease_duration // 0')
    echo "renewed to +$((dur / 60))m"
    exit 0
fi

if [ "${1:-}" = "--end" ]; then
    _login_once
    if [ ! -f "$LEDGER" ]; then
        echo "no credentials outstanding from this machine"
        exit 0
    fi
    rev=0
    while IFS= read -r lease_line; do
        [ -n "$lease_line" ] || continue
        lease=$(printf '%s' "$lease_line" | jq -r '.lease_id // empty')
        [ -n "$lease" ] || continue
        if "$CLI" lease revoke "$lease" >/dev/null 2>&1; then
            echo "revoked $lease"
        else
            echo "closed  $lease"
        fi
        rev=$((rev + 1))
    done < "$LEDGER"
    rm -f "$LEDGER"
    rmdir "${LEDGER%/*}" 2>/dev/null
    echo "$rev credential(s) ended"
    exit 0
fi

_discover() {
    "$CLI" secrets list -detailed -format=json 2>/dev/null \
        | jq -r 'to_entries[] | select(.value.type == "database") | .key' \
        | sed 's|/$||'
}
_mounts() {
    _discover
}

_roles() { # <mount>
    "$CLI" list -format=json "$1/roles" 2>/dev/null | jq -r '.[]'
}

if [ "${1:-}" = "list" ]; then
    mounts="$(_mounts)"
    for mount in $mounts; do
        printf '%s: %s\n' "$mount" "$(_roles "$mount" | tr '\n' ' ')"
    done
    exit 0
fi

[ $# -ge 1 ] || { echo "usage: buapedb <name> [--write] | list" >&2; exit 1; }
request="$1"
level="ro"
case "${2:-}" in
    "") ;;
    -ro|--read) ;;
    -rw|--write) level="rw" ;;
    *) echo "unknown flag '${2}' (use --write for read-write access)" >&2; exit 1 ;;
esac

# resolve <request> (plus level) to exactly one <mount>/<role>
# among everything OpenBao currently advertises
resolve() {
    target="$1"
    for mount in $(_mounts); do
        for role in $(_roles "$mount"); do
            [ "$role" = "$target" ] && { echo "$mount $role"; return 0; }
        done
    done
    return 1
}

target="$request"
case "$target" in
    *-ro) [ "$level" = "rw" ] && target="${target%-ro}-rw" ;;
    *-rw) [ "$level" = "ro" ] && target="${target%-rw}-ro" ;;
esac

# try the exact (possibly level-adjusted) role first, then the
# bare-name-plus-suffix forms like "orbit" → "orbit-ro"
if ! result="$(resolve "$target")"; then
    if ! result="$(resolve "${request}-${level}")"; then
        echo "no database credentials match '$request' (try 'buapedb list')" >&2
        exit 1
    fi
fi
mount="${result%% *}"
role="${result#* }"

# login only when we don't hold a token yet; browser handles Buape Auth SSO
_login_once

resp="$("$CLI" read -format=json "$mount/creds/$role")" || {
    echo "failed to read $mount/creds/$role — is your Authentik group $role?" >&2
    exit 1
}

user="$(printf '%s' "$resp" | jq -r '.data.username')"
pass="$(printf '%s' "$resp" | jq -r '.data.password')"

# track the lease so --end can revoke it later
lease_id="$(printf '%s' "$resp" | jq -r '.lease_id // empty')"
if [ -n "$lease_id" ]; then
    mkdir -p "${LEDGER%/*}"
    printf '{"lease_id": %s, "issued_at": %s}\n' \
        "$(printf '%s' "$lease_id" | jq -R .)" "$(date +%s)" >> "$LEDGER"
fi

if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$pass" | pbcopy
    echo "  username: $user"
    echo "  password: copied to clipboard (paste in your database tool)"
else
    echo "paste into the password field of your database tool:"
    printf '  password: %s\n' "$pass"
fi
expires=$(printf '%s' "$resp" | jq -r '(.lease_duration // 0) as $d | if $d > 0 then (now + $d | strftime("%H:%M, " + ($d/60 | floor | tostring) + "m from now")) else "unknown" end')
echo "  expires:  $expires"
if [ -n "$(printf '%s' "$resp" | jq -r '.lease_id // empty')" ] && printf '%s' "$resp" | jq -e '.renewable == true' >/dev/null; then
    echo "  renew:    buapedb --renew $(printf '%s' "$resp" | jq -r '.lease_id')"
fi